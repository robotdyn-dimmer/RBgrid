/*
 * wifi_secrets.h.example — template for local WiFi credentials.
 *
 * The real file `main/wifi_secrets.h` is GITIGNORED — secrets must never be committed.
 *
 * Setup:
 *   1. Copy this file:   main/wifi_secrets.h.example  ->  main/wifi_secrets.h
 *   2. Fill in the two #defines below with your bench WiFi.
 *   3. Rebuild. main.cpp auto-includes it via __has_include and connects in STA mode.
 *
 * If main/wifi_secrets.h is absent, the firmware falls back to NVS-stored credentials
 * (set via the AP config portal).
 */
#ifndef WIFI_SECRETS_H
#define WIFI_SECRETS_H

#define WIFI_SSID "YOUR_SSID_HERE"
#define WIFI_PASS "YOUR_PASSWORD_HERE"

#endif // WIFI_SECRETS_H
